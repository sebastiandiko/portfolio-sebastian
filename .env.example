# EmailJS (https://www.emailjs.com) — required for the contact form in Contact.js
# 1. Create a free account and an Email Service (e.g. Gmail).
# 2. Create an Email Template with these variables: {{from_email}}, {{subject}}, {{message}}
# 3. Copy the IDs below into a local .env.local file (already gitignored).
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=
